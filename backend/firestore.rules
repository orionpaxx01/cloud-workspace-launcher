rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Every workspace document carries an `owner` field set to the
    // authenticated user's uid. Reads and writes are scoped to that owner,
    // so one user can never touch another user's workspaces.
    match /workspaces/{workspaceId} {
      allow read, write: if request.auth != null
                       && request.auth.uid == resource.data.owner;
    }
  }
}